{
  "$schema": "tokens.v1",
  "name": "Hosszú távon — design tokenek",
  "version": "0.1.0",
  "color": {
    "paper": { "value": "#fcfcfb", "role": "oldal háttér (PDF és web)" },
    "plane": { "value": "#f4f4f1", "role": "másodlagos felület: dobozok, sávok" },
    "ink": { "value": "#0b0b0b", "role": "elsődleges szöveg" },
    "ink-2": { "value": "#52514e", "role": "másodlagos szöveg, feliratok" },
    "muted": { "value": "#898781", "role": "tengelyfelirat, lábjegyzet, példa-elem" },
    "hairline": { "value": "#e1e0d9", "role": "rácsvonal, elválasztó" },
    "baseline": { "value": "#c3c2b7", "role": "tengely, keret" },
    "brand": { "value": "#184f95", "role": "márkaszín — éjszakai kék; címek, fix ajánlás" },
    "brand-deep": { "value": "#0d366b", "role": "sötét kék — fejezetnyitó, A fokozat" },
    "accent": { "value": "#eb6834", "role": "hajnal-narancs — kiemelés, egyéni-változó elem" },
    "evidence": {
      "A": { "value": "#0d366b", "label": "A — RCT / meta-analízis" },
      "B": { "value": "#256abf", "label": "B — terepvizsgálat, megfigyelés" },
      "C": { "value": "#5598e7", "label": "C — edzői / versenyzői konszenzus" },
      "D": { "value": "#86b6ef", "label": "D — feltörekvő, nem validált" },
      "note": "Ordinális kék ramp, validálva (monoton L, ΔL ≥ 0.06, világos vég 2.06:1). A betű mindig kiírva — a szín csak támogat."
    },
    "template": {
      "fix": { "value": "#184f95", "style": "tömör keret, kitöltött pötty", "label": "fix ajánlás" },
      "example": { "value": "#898781", "style": "szaggatott keret, üres pötty", "label": "példa / iránymutatás" },
      "individual": { "value": "#eb6834", "style": "tömör keret, személy-ikon", "label": "egyénileg mérendő" },
      "note": "A stílus (keret, ikon) hordozza a jelentést, a szín másodlagos."
    },
    "series": {
      "1": "#2a78d6", "2": "#eb6834", "3": "#1baf7a", "4": "#eda100",
      "5": "#e87ba4", "6": "#008300", "7": "#4a3aa7", "8": "#e34948",
      "note": "Kategorikus diagram-paletta, rögzített sorrend (dataviz referencia, validált). 3-nál több sorozat pontdiagramon: bontsd kis multiplikra."
    },
    "sequential": ["#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#184f95", "#0d366b"],
    "diverging": { "neg": "#e34948", "mid": "#f0efec", "pos": "#2a78d6" },
    "status": {
      "good": "#0ca30c", "warning": "#fab219", "serious": "#ec835a", "critical": "#d03b3b",
      "note": "Biztonsági küszöbökhöz (pl. alvásmegvonás veszélyzónái). Mindig ikon + felirat, soha csak szín."
    }
  },
  "type": {
    "candidates": {
      "plex": { "sans": "IBM Plex Sans", "mono": "IBM Plex Mono", "display": "IBM Plex Sans" },
      "inter": { "sans": "Inter", "mono": "IBM Plex Mono", "display": "Inter Display" }
    },
    "scale-pt": { "display": 34, "h1": 24, "h2": 16, "body": 10.5, "small": 8.5, "caption": 7.5, "hero": 56 },
    "leading": { "body": 1.45, "heading": 1.15 },
    "numerics": "tabular-nums táblázatban és tengelyen; proporcionális a hero számoknál"
