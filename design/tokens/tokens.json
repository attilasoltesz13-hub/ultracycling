    "footer": "modulszám · cím · oldalszám; verzió és dátum a címlapon"
  },
  "radius-mm": { "box": 1.5, "chip": 6 },
  "stroke-mm": { "hairline": 0.2, "rule": 0.4, "chart-line": 0.6 }
